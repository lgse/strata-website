# Set your final public origin before deploying (no trailing path).
# Vercel deployments automatically use VERCEL_PROJECT_PRODUCTION_URL if unset or blank.
# On Vercel, omit this variable unless you are setting a custom HTTPS origin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Discord interactions endpoint and public GitHub PR tracking (server-only).
DISCORD_PUBLIC_KEY=
GITHUB_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Used only by scripts/register-discord-commands.mjs, not needed at runtime.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
# Optional: register in a test server instead of globally.
DISCORD_GUILD_ID=
